# E2E Test Environment — isolated PostgreSQL database
# Copy to .env.e2e and adjust credentials if needed.
#
# This file points to the dedicated E2E container (financetracker-postgres-e2e)
# which runs on port 5433 alongside the dev database (port 5432).
# Start it with: docker-compose -f docker-compose.postgres.yml up -d postgres-e2e

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=financetracker-postgres-e2e
POSTGRES_SCHEMA=public
PRISMA_E2E=1

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=${POSTGRES_SCHEMA}

JWT_SECRET=finance-tracker-pro-secret-key-change-in-production-min-32-characters-long
BASE_URL=http://localhost:3000

# E2E test user credentials (created automatically by globalSetup before each run)
E2E_TEST_USER=e2e@financetrackerpro.com
E2E_TEST_PASSWORD=E2ePassword123
