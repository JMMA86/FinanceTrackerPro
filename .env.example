# Development Environment — local PostgreSQL database
# Copy to .env and fill in the required values.
#
# This file points to the dev container (financetracker-postgres)
# which runs on port 5432.
# Start it with: docker-compose -f docker-compose.postgres.yml up -d postgres

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=financetracker-postgres
POSTGRES_SCHEMA=public

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=${POSTGRES_SCHEMA}

JWT_SECRET=
BASE_URL=http://localhost:3000

# Optional — required only for SonarQube static analysis
SONAR_TOKEN=
